{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Cleaned PostgreSQL Dashboard for TeamPulse (Docker Native)",
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 34,
      "panels": [],
      "title": "General Counters & Status",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "format": "dateTimeFromNow",
      "gridPos": { "h": 3, "w": 6, "x": 0, "y": 1 },
      "id": 28,
      "title": "PostgreSQL Start Time",
      "type": "singlestat",
      "targets": [
        {
          "expr": "pg_postmaster_start_time_seconds{instance=~\"$instance\"} * 1000",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "valueName": "avg"
    },
    {
      "datasource": "Prometheus",
      "format": "none",
      "gridPos": { "h": 3, "w": 6, "x": 6, "y": 1 },
      "id": 38,
      "title": "Max Connections Allowed",
      "type": "singlestat",
      "targets": [
        {
          "expr": "pg_settings_max_connections{instance=~\"$instance\"}",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "valueName": "avg"
    },
    {
      "datasource": "Prometheus",
      "format": "short",
      "gridPos": { "h": 3, "w": 6, "x": 12, "y": 1 },
      "id": 11,
      "title": "Total Rows Inserted",
      "type": "singlestat",
      "targets": [
        {
          "expr": "SUM(pg_stat_database_tup_inserted{datname=~\"$datname\", instance=~\"$instance\"})",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "valueName": "current"
    },
    {
      "datasource": "Prometheus",
      "format": "short",
      "gridPos": { "h": 3, "w": 6, "x": 18, "y": 1 },
      "id": 12,
      "title": "Total Rows Updated",
      "type": "singlestat",
      "targets": [
        {
          "expr": "SUM(pg_stat_database_tup_updated{datname=~\"$datname\", instance=~\"$instance\"})",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "valueName": "current"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "id": 30,
      "panels": [],
      "title": "Database Activity & Performance",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 5 },
      "id": 1,
      "title": "Active Sessions",
      "type": "graph",
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname=~\"$datname\", instance=~\"$instance\", state=\"active\"}",
          "legendFormat": "{{datname}} - Active",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 5 },
      "id": 60,
      "title": "Transactions Rate (Commits vs Rollbacks)",
      "type": "graph",
      "targets": [
        {
          "expr": "irate(pg_stat_database_xact_commit{instance=~\"$instance\", datname=~\"$datname\"}[5m])",
          "legendFormat": "{{datname}} Commits",
          "refId": "A"
        },
        {
          "expr": "irate(pg_stat_database_xact_rollback{instance=~\"$instance\", datname=~\"$datname\"}[5m])",
          "legendFormat": "{{datname}} Rollbacks",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 12 },
      "id": 62,
      "title": "Cache Hit Rate Ratio",
      "type": "graph",
      "targets": [
        {
          "expr": "pg_stat_database_blks_hit{instance=~\"$instance\", datname=~\"$datname\"} / (pg_stat_database_blks_read{instance=~\"$instance\", datname=~\"$datname\"} + pg_stat_database_blks_hit{instance=~\"$instance\", datname=~\"$datname\"})",
          "legendFormat": "{{datname}} Hit Rate",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 12 },
      "id": 66,
      "title": "Deadlocks and Conflicts Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "irate(pg_stat_database_deadlocks{instance=~\"$instance\", datname=~\"$datname\"}[5m])",
          "legendFormat": "{{datname}} Deadlocks",
          "refId": "A"
        },
        {
          "expr": "irate(pg_stat_database_conflicts{instance=~\"$instance\", datname=~\"$datname\"}[5m])",
          "legendFormat": "{{datname}} Conflicts",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 19,
  "style": "dark",
  "tags": [
    "postgresql",
    "teampulse",
    "database"
  ],
  "templating": {
    "list": [
      {
        "datasource": "Prometheus",
        "hide": 0,
        "includeAll": true,
        "label": "Instance",
        "multi": false,
        "name": "instance",
        "query": "label_values(pg_settings_max_connections, instance)",
        "refresh": 1,
        "type": "query"
      },
      {
        "datasource": "Prometheus",
        "hide": 0,
        "includeAll": true,
        "label": "Database",
        "multi": true,
        "name": "datname",
        "query": "label_values(pg_stat_database_tup_inserted, datname)",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "PostgreSQL Database",
  "uid": "teampulse-postgres-db",
  "version": 3
}