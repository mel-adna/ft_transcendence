  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "HTTP Traffic & Performance Metrics (Backend API)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"teampulse-backend\"}[1m])) by (uri, status)",
          "legendFormat": "{{uri}} ({{status}})",
          "refId": "A"
        }
      ],
      "title": "HTTP Requests Rate by URI & Status",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"teampulse-backend\"}[1m])) by (uri) / sum(rate(http_server_requests_seconds_count{job=\"teampulse-backend\"}[1m])) by (uri)",
          "legendFormat": "Avg Latency - {{uri}}",
          "refId": "A"
        }
      ],
      "title": "HTTP Response Latency (Avg Latency per Endpoint)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "panels": [],
      "title": "WebSocket & Realtime Chat Service Metrics",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 10 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "chat_socket_connections_total",
          "legendFormat": "Active Sockets",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "chat_online_users_total",
          "legendFormat": "Online Users",
          "refId": "B"
        }
      ],
      "title": "Active WebSocket / Chat Connections",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "mps"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 10 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(chat_messages_sent_total[1m]))",
          "legendFormat": "Messages Rate (req/s)",
          "refId": "A"
        }
      ],
      "title": "Chat Messages Exchanged Rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 7,
      "panels": [],
      "title": "Database Connection Pool & Business Entities",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 18 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "hikaricp_connections_active{job=\"teampulse-backend\"}",
          "legendFormat": "Active DB Connections",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "hikaricp_connections_idle{job=\"teampulse-backend\"}",
          "legendFormat": "Idle DB Connections",
          "refId": "B"
        }
      ],
      "title": "HikariCP Database Connection Pool Status",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 18 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "pg_stat_user_tables_n_live_tup{relname=~\"tasks|users|workspaces\"}",
          "legendFormat": "Table: {{relname}}",
          "refId": "A"
        }
      ],
      "title": "Database Entities Record Counts (Tasks, Users, Workspaces)",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["teampulse", "monitoring", "custom"],
  "time": { "from": "now-1h", "to": "now" },
