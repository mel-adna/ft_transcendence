
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(uuid())
  username        String
  email           String       @unique
  passwordHash    String
  avatarUrl       String?
  presenceStatus  String       @default("OFFLINE")
  lastSeenAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  sentMessages    Message[]
  roomMemberships RoomMember[]
  readReceipts    ReadReceipt[]

  @@index([presenceStatus])
}

model Room {
  id        String       @id @default(uuid())
  name      String?
  type      String       @default("GROUP")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  members      RoomMember[]
  messages     Message[]
  readReceipts ReadReceipt[]

  @@index([type])
}

model RoomMember {
  roomId    String
  userId    String
  role      String   @default("MEMBER")
  status    String   @default("ACCEPTED")
  joinedAt  DateTime @default(now())

  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
  @@index([status])
}

model Message {
  id        String    @id @default(uuid())
  roomId    String
  senderId  String
  content   String    @db.VarChar(4000)
  type      String    @default("TEXT")
  parentId  String?
  isEdited  Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id])
  parent    Message?  @relation("MessageThread", fields: [parentId], references: [id])
  replies   Message[] @relation("MessageThread")
  readReceipts ReadReceipt[] @relation("ReadReceiptMessage")

  @@index([roomId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([parentId])
}

model ReadReceipt {
  roomId            String
  userId            String
  lastReadMessageId String?
  readAt            DateTime @default(now())

  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadMessage Message? @relation("ReadReceiptMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@id([roomId, userId])
  @@index([userId])
}
