# Java backend. Relative path so the browser stays same-origin.
# In dev, Vite proxies it to CORE_API_PROXY_TARGET. In production, nginx serves both.
VITE_CORE_API_URL=/api/v1
CORE_API_PROXY_TARGET=http://localhost:8080

# Node chat backend (aarab's module reads these two names).
VITE_API_URL=http://localhost:5005/api
VITE_WS_URL=http://localhost:5005


